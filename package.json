{
  "name": "occess",
  "version": "1.0.0",
  "description": "Occess - Sistema de Gestion y Filtrado",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:portable": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis",
    "build:all": "electron-builder --win nsis portable",
    "release": "electron-builder --win nsis portable --publish always"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.occess.desktop",
    "productName": "Occess",
    "publish": [
      {
        "provider": "github",
        "owner": "fuegoleon",
        "repo": "Occess"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Occess",
      "artifactName": "Occess-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Occess.exe"
    },
    "files": [
      "index.html",
      "styles.css",
      "app.js",
      "data.js",
      "xlsx.full.min.js",
      "tablas_referencia.json",
      "main.js",
      "preload.js",
      "package.json",
      "icon.ico",
      "OCCESS.png"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
